# Copiar para .env.local e ajustar. Todas as variáveis VITE_* acabam no bundle
# público: nunca colocar aqui segredos (client secrets, chaves privadas, tokens).

# URL da API. Sem esta variável o frontend usa a API de produção.
VITE_API_URL="http://localhost:8080"

# Client ID OAuth do Google (público). Tem de coincidir com GOOGLE_CLIENT_ID do backend.
VITE_GOOGLE_CLIENT_ID=""
